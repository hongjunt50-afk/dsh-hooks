{
  "name": "@dsh-external/dsh-hooks",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness 通用钩子框架：用 Claude Code 风格的 hooks.json 驱动 DSH 原生事件（SessionStart / UserPromptSubmit / PreToolUse / PostToolUse / Stop）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hooks",
    "claude-code"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "examples",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
